<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: tap points are screen positions for this one phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
